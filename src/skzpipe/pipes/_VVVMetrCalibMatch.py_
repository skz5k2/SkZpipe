{print"Tile\x20 fam\x20 \x20 \x20OB \x20\x20filter\x20chip\x20offset \x20 file\n";
for my $i (sort keys %regroup){print "$i \x20 \x20 $regroup{$i}\n";}print "\n";
}

  WAIT:
  $prewait=time;
  while(-e "WAIT" || -e "Calibration.WAIT" || -e "${scriptname}.WAIT"){    sleep 10;  }
  if(-e "STOP" || -e "Calibration.STOP" || -e "${scriptname}.STOP"){
unlink $lockfile;
 die "!!!Obbedisco!\n\n";}
  $start+=time-$prewait;

print "%%%%%%Calibration%%%%%%\n\n";
my%fco_;
for my $obfovk (sort keys %obfov){
  print sprintf("%-14s",$obfovk), "  ";
  my@q=split/\s+/,$obfov{$obfovk};
  my(%ff,$c);
  for my$f(@q){ #cicle over images in same OB/FOV
    $ff{(split/\s+/,$datahash{$f})[4]}=$f;   #whick filter is which image
  } 
  for my$j (@fff){  #Cicle over filters
    $ff{$j}="-" if(!$ff{$j});   #If a filter not present, set as '-'
    print "$j:$ff{$j}    ";
  }
  print "\n";
  $obfov{$obfovk}=join " ",$ff{"J"}, $ff{"H"}, $ff{"Ks"}, $ff{"Y"}, $ff{"Z"};  #redefining th entry of OB/FOV but in order
  my($nnn,$sss);
  ($nnn="$workname $obfovk")=~s/ /_/g;   #string workname_obname_fam_chp_off
  ($sss=$obfovk)=~s/^(\S+) /$o_t{$1} /;  #string tile_fam_chp_off  => general FOV
  if($ff{"J"}ne"-" && $ff{"H"}ne"-" && $ff{"Ks"}ne"-"){  #If there are all J-H-Ks
    {
    my ($mch, $flag, $sigma, @files)=("${nnn}_calJHKs.mch", 1, 5, $ff{"J"}.".$alfsuffcl", $ff{"H"}.".$alfsuffcl", $ff{"Ks"}.".$alfsuffcl");
    unlink "${nnn}_calJHKs.raw","${nnn}_calJHKs.tfr";
    open(MM,"|${pathdir}VVV-DoMatch.pl");print MM "$mch 1 $flag $sigma 2 cal ", join (" ", @files, "\n");print MM "$mch 0 $flag $sigma 2 cal ", join (" ", @files, "\n");close MM;
    }
    my$typtr=$notsamecol+3;
    `${pathdir}calibVVV ${nnn}_calJHKs 3  $typtr $cal{$ff{"J"}} $cal{$ff{"H"}} $cal{$ff{"Ks"}}`;
    rename "${nnn}_calJHKs.raw_cal_1.als", "${nnn}.J";
    rename "${nnn}_calJHKs.raw_cal_2.als", "${nnn}.H";
    rename "${nnn}_calJHKs.raw_cal_3.als", "${nnn}.Ks";
    print "\t==>\x20${nnn}.J\x20\x20\x20\x20\x20${nnn}.H\x20\x20\x20\x20\x20\x20${nnn}.Ks\n";
    #Adding to FOV-Filter the name of the file
    $fov_flt{"$sss J"}.="${nnn}.J ";
    $fov_flt{"$sss H"}.="${nnn}.H ";
    $fov_flt{"$sss Ks"}.="${nnn}.Ks ";

  }elsif($ff{"Ks"}ne"-"){ #If there is only Ks: epoch!
    my $j=$obfovk;$j=~s/ /_/g;
    $j=~s/^(.+)_(.+_.+_.+)$/${workname}_$o_t{$1}j_$2.J/;  #As J use the J from obname=tile+'j' the first J vailable
    my ($mch, $flag, $sigma, @files)=("${nnn}_calKs.mch", 1, 5, $ff{"Ks"}.".$alfsuffcl", $j);
    unlink "${nnn}_calKs.raw","${nnn}_calKs.tfr";
    open(MM,"|${pathdir}VVV-DoMatch.pl");print MM "$mch 1 $flag $sigma 2 cal ", join (" ", @files, "\n");print MM "$mch 0 $flag $sigma 2 cal ", join (" ", @files, "\n");close MM;
    `${pathdir}calibVVV ${nnn}_calKs 1  1 $cal{$ff{"Ks"}}`;
    rename "${nnn}_calKs.raw_cal_1.als", "${nnn}.Ks";
    unlink "${nnn}_calKs.raw_cal_2.als";
    print "\t==> ${nnn}.Ks\n";
    #Adding to FOV-Filter the name of the file
    $fov_flt{"$sss Ks"}.="${nnn}.Ks "; 

  }elsif($ff{"Y"}ne"-" && $ff{"Z"}ne"-"){   #if there is Y-Z
    unlink "${nnn}.Y", "${nnn}.Z";
    if(0 && "YZ"=~/($filterstdcat)/){
      symlink $ff{"Y"}.".$alfsuffcl", $ff{"Y"}.".mag";
      `${pathdir}calibVVV $ff{"Y"} 1 0 $cal{$ff{"Y"}} `;
      rename $ff{"Y"}.".mag_cal", "${nnn}.Y";
      $fov_flt{"$sss Y"}.="${nnn}.Y ";
      symlink $ff{"Z"}.".$alfsuffcl", $ff{"Z"}.".mag";
      `${pathdir}calibVVV $ff{"Z"} 1 0 $cal{$ff{"Z"}} `;
      rename $ff{"Z"}.".mag_cal", "${nnn}.Z";
      $fov_flt{"$sss Z"}.="${nnn}.Z ";
    }else{
      copy $ff{"Y"}.".$alfsuffcl", "${nnn}.Y";
      $fov_flt{"$sss Y"}.="${nnn}.Y ";
      copy $ff{"Z"}.".$alfsuffcl", "${nnn}.Z";
      $fov_flt{"$sss Z"}.="${nnn}.Z ";
    }
    print "\t==>\x20${nnn}.Y\x20\x20\x20\x20\x20${nnn}.Z\n";
  }
  $nnn=join " ",(split m.\s+.,$obfovk)[2,3];
  $fco_{$nnn}="";
  print "\n\n";
}

$prewait=time;
while(-e "WAIT" || -e "${scriptname}.WAIT"){  sleep 10;}
if(-e "STOP" || -e "${scriptname}.STOP" || -e "Reunion.STOP"){
unlink $lockfile;
die "!!!Obbedisco!\n\n";}
$start+=time-$prewait;

print "\n\n%%%%%%Reunion%%%%%%\n";
$nfltrstd=5 if($nfltrstd==-3);
  (@totar)=($imgdatafile, "$imgdatafile.html", $OptFile);
for my $ttf ("${workname}_cal.ps","${workname}_clean.ps", "${workname}-dat", $stdcat, $getinfodatafile, $calfile){push @totar, $ttf if(-e $ttf);}
  (@elit,@t_ty,%tflt, %tstc, $tttt, $fmst, @lststr)=();
  $mchmd="match";

###SUBRUTINES####
sub BuildCtlg{
  if($mchmd=~/match/){
    my$fmst0=$fmst*1e+8;
    `${pathdir}fixCtlg ${rraww}raw $fmst0 ${workname}-dat $wantedfilter ${rraww}Ctlg`;
  }elsif($mchmd=~/union/){
   $_=`${pathdir}unionVVVstripe 0 $tstc{$tttt} ${rraww}Ctlg`;
   @lststr=split;
  }
    push @totar, "${rraww}Ctlg";
}

sub PlotDmCMD {
  my $titlegp="${idxwntk}";$titlegp=~s/_/\\\\_/g;
  open(CTLG,"${rraww}Ctlg");open(MCD, ">${rraww}mc");while(<CTLG>){if(!/^#/){my@qqq=split;print MCD sprintf("%.4f %.4f %.4f %.4f\n", $qqq[9],($qqq[5]-$qqq[9]),($qqq[5]-$qqq[7]),($qqq[7]-$qqq[9]));}}close CTLG; close MCD;
  `${pathdir}convfreqSkZ -i ${rraww}mc -o ${rraww}mcfr -x 8.5 -X 20.5 -wx 1  -sx 1  -y -2 -Y 6 -wy $widthcolor -sy $widthcolor --format=matrix`;
  `${pathdir}convfreqSkZ -i ${rraww}mc -o ${rraww}mfr  -x 8.5 -X 20.5 -wx .1 -sx 0.01`;

    open(GP,"|gnuplot");print GP qq%set terminal postscript enhanced\nset output "${idxwntk}_cmd.ps"\nset title "$titlegp"\n%;
    print GP qq%set xlabel "J-Ks"\nset ylabel "Ks"\nset xtics -2,.5\nset ytics 7.5,1\nset grid\n%;
    print GP qq%plot [-1:6][21:7] "${rraww}mc" u 2:1  w d noti\n%;
    print GP qq%set xlabel "(J-H)-1.47(H-Ks)"\n%;
    print GP qq%plot [-1:3][21:7] "${rraww}mc" u (\$3-1.47*\$4):1  w d noti\n%;
    print GP qq%set yrange [] noreverse\nset xlabel "H-Ks"\nset ylabel "J-H"\nset ytics -2,.5\n%;
    print GP qq%plot [-1:4][-2:5] "${rraww}mc" u 4:3  w d noti\n%;
    print GP qq%set yrange [] noreverse\nset xlabel "Ks"\nset ylabel "num of stars (bin width=0.1mag  step=0.01)"\nset ytics auto\n%;
    print GP qq%plot [][] "${rraww}mfr" w l noti\n%;
    print GP qq%set yrange [] noreverse\nset xlabel "Ks"\nset ylabel "Log10 num of stars (bin width=0.1mag  step=0.01)"\nset ytics auto\n%;
    print GP qq%plot [][] "${rraww}mfr" u 1:(log10(\$2)) w l noti\n%;
    print GP qq%set xlabel "J-Ks"\nset ylabel "num of stars (bin width=$widthcolor)"\nset ytics auto\n%;
    for my$mag (9..20){print GP qq%set title "Ks=$mag"\nplot [][] "${rraww}mcfr" u 1:%,$mag-7,qq% w l noti\n%;}
    print GP qq%quit\n%;close GP;

    unlink "${rraww}mc", "${rraww}mcfr", "${rraww}mfr";
    push @totar, "${idxwntk}_cmd.ps";

    my($denmap)=("${idxwntk}_denmap.fits");
    unlink $denmap;
    open(RADEC,">${rraww}radec");open(CTLG, "${rraww}Ctlg");
    while(<CTLG>){next if(/^#/);
      my@vvv=split;print RADEC "$vvv[1] $vvv[2] J2000\n" if ($vvv[9]<=$denmapmaglim);}
    close RADEC; close CTLG;
    `${pathdir}sky2xy $tyuiop.fits "@"${rraww}radec | cut -d'>' -f 2 > ${rraww}xy`;
    unlink "${rraww}radec";
    print "Image used to get x,y: $tyuiop\n";
    if($denmap_nx>0 && $denmap_ny>0){
      `${pathdir}convfreqSkZ -i ${rraww}xy -wx $denmapbin --format=fits -o $denmap --shape=elliptic -nx $denmap_nx  -ny $denmap_ny`;
    }else{
      `${pathdir}convfreqSkZ -i ${rraww}xy -wx $denmapbin --format=fits -o $denmap --shape=elliptic`;
    }
    unlink "${rraww}xy";

    `${pathdir}fits_modhdr $denmap "CATALOG" "${rraww}Ctlg"`;
    `${pathdir}fits_modhdr $denmap "MAG-CUT" $denmapmaglim`;
    `${pathdir}cphead $tyuiop.fits $denmap  CTYPE1 CTYPE2 CRVAL1 CRVAL2 CRPIX1 CRPIX2 CD1_1 CD1_2 CD2_1 CD2_2 PV2_1 PV2_2 PV2_3 PV2_4 PV2_5`;
    push @totar, "$denmap";
}

sub TooMASScmpplot {
    print"\n $zxpoc[0] $zxpoc[1] $zxpoc[2]\n";
    my ($dbg2m, $dbg2ms);
    if($debug){  ($dbg2m, $dbg2ms)=("STD-${idxwntk}.out", "STD-${idxwntk}.outs")}
    print "Comparison with $stdcat $idxwntk.stdat ...\n";
    print`${pathdir}cmpSTD-Ctlg 1,11,.34 $radexc $sigmaclipSTD $stdcat        $stdposcoomag,$nfltrstd ${rraww}Ctlg STD-${idxwntk}.cat`;  # $zxpoc[0],$zxpoc[1],$zxpoc[2] $dbg2m`;
    my$calposcoomag="2,4";
         `${pathdir}cmpSTD-Ctlg 1,11,.34 $radexc $sigmaclipSTD $idxwntk.stdat $calposcoomag,$nfltrstd ${rraww}Ctlg STD-${idxwntk}.cats`; # $zxpoc[0],$zxpoc[1],$zxpoc[2] $dbg2ms`;
    my$cmpmaxdist=1;
#    unlink $dbg2m, $dbg2ms if(!$debug);
    push @totar, "$idxwntk.stdat";
    push @totar, "STD-${idxwntk}.cat", "STD-${idxwntk}.cats", "STD-${idxwntk}.cat-rej";

    my$i="STD-${idxwntk}.cat";
    my$is=$i."s";
    my($tmpJ,$tmpH,$tmpK,$tmpY,$tmpZ);
    while(-f ($tmpJ="ZJ".chr(rand(26)+ord("A")).(time)) || -f "$tmpJ.fr"){}
    while(-f ($tmpH="ZH".chr(rand(26)+ord("A")).(time)) || -f "$tmpH.fr"){}
    while(-f ($tmpK="ZK".chr(rand(26)+ord("A")).(time)) || -f "$tmpK.fr"){}
    if($nfltrstd>3){ while(-f ($tmpY="ZY".chr(rand(26)+ord("A")).(time)) || -f "$tmpY.fr"){} }
    if($nfltrstd>4){ while(-f ($tmpZ="ZZ".chr(rand(26)+ord("A")).(time)) || -f "$tmpZ.fr"){} }

    open(FIN,$i);open(FOUT,">$i.g");open(FOUR,">$i.b");open(FOUJ,">$tmpJ");open(FOUH,">$tmpH");open(FOUK,">$tmpK");open(FOUY,">$tmpY")if($nfltrstd>3);open(FOUZ,">$tmpZ")if($nfltrstd>4); open(FODR,">$i.r");open(FODX,">$i.x");open(FODY,">$i.y");
    my($posJS,$posHS,$posKS,$posYS,$posZS)=(2,4,6,8,10);
    my($posJV,$posHV,$posKV,$posYV,$posZV)=($posJS+2*$nfltrstd,$posHS+2*$nfltrstd,$posKS+2*$nfltrstd,$posYS+2*$nfltrstd,$posZS+2*$nfltrstd);
    my(@qqqq,$ncmpfld);
    while(<FIN>){
      next if(/^#/);
      @qqqq=split;
      if($qqqq[3]*$qqqq[5]*$qqqq[7]!=0){print FOUT;
        print FOUJ sprintf("%.4f %.4f\n",$qqqq[$posJV], ($qqqq[2]-$qqqq[$posJV]));
        print FOUH sprintf("%.4f %.4f\n",$qqqq[$posHV], ($qqqq[4]-$qqqq[$posHV]));
        print FOUK sprintf("%.4f %.4f\n",$qqqq[$posKV], ($qqqq[6]-$qqqq[$posKV]));
        print FOUY sprintf("%.4f %.4f\n",$qqqq[$posYV], ($qqqq[8]-$qqqq[$posYV])) if($nfltrstd>3);
        print FOUZ sprintf("%.4f %.4f\n",$qqqq[$posZV], ($qqqq[10]-$qqqq[$posZV])) if($nfltrstd>4);
        #print FOUJK sprintf("%.4f %.4f\n",$qqqq[6+2*$nfltrstd], ($qqqq[2]-$qqqq[2+2*$nfltrstd]-$qqqq[8]+$qqqq[8+2*$nfltrstd]));
      }else{print FOUR;}
      print FODR $qqqq[-5],"\n";
      print FODX $qqqq[-4],"\n";
      print FODY $qqqq[-3],"\n";

    }
    $ncmpfld=@qqqq;
    for(my$qqqq=0; $qqqq<$ncmpfld; $qqqq++){    print FOUR  " 0";} print FOUR "\n";
    close FIN; close FOUT;close FOUR;close FOUJ;close FOUH;close FOUK;close FOUY if($nfltrstd>3);close FOUZ if($nfltrstd>4); close FODR;close FODX;close FODY;

    `convfreqSkZ -i $tmpJ -o $tmpJ.fr -x 8 -X 17 -y -.502 -Y .502 -wx .1 -wy 0.02 -sx .1 -sy 0.004 --format=listgp`;
    `convfreqSkZ -i $tmpH -o $tmpH.fr -x 8 -X 16 -y -.502 -Y .502 -wx .1 -wy 0.02 -sx .1 -sy 0.004 --format=listgp`;
    `convfreqSkZ -i $tmpK -o $tmpK.fr -x 8 -X 16 -y -.502 -Y .502 -wx .1 -wy 0.02 -sx .1 -sy 0.004 --format=listgp`;
    `convfreqSkZ -i $i.r  -o $i.rfr -wx .05 -sx .05 -x  0           -X $cmpmaxdist`;
    `convfreqSkZ -i $i.x  -o $i.xfr -wx .05 -sx .05 -x -$cmpmaxdist -X $cmpmaxdist`;
    `convfreqSkZ -i $i.y  -o $i.yfr -wx .05 -sx .05 -x -$cmpmaxdist -X $cmpmaxdist`;

open(FINJ,">$tmpJ");open(FINH,">$tmpH");open(FINK,">$tmpK");
print FINJ "8 0.02 0\n17 0.02 0\n";
print FINH "8 -0.02 0\n17 -0.02 0\n";
close(FINJ);close(FINH);close(FINK);

    unlink "$i.r", "$i.x", "$i.y";
####
    $posJS++;$posHS++;$posKS++;$posYS++;$posZS++;
    $posJV++;$posHV++;$posKV++;$posYV++;$posZV++;
    my($posJE,$posHE,$posKE,$posYE,$posZE)=($ncmpfld-6-$nfltrstd, $ncmpfld-5-$nfltrstd, $ncmpfld-4-$nfltrstd, $ncmpfld-3-$nfltrstd, $ncmpfld-2-$nfltrstd);
    open (GP, "|gnuplot");
    my $titlegp="${idxwntk} \x20 \x20 STD vs VSp";$titlegp=~s/_/\\\\_/g;
    print GP qq%set terminal postscript enhanced color\nset output "STD-${idxwntk}.ps"\n%;
    print GP qq%set title "$titlegp"\n%;
####
    print GP qq%set grid\nset xzeroaxis lt -1\nset title "$titlegp"\n%;
    print GP qq%set ylabel "(J-Ks)_{STD}-(J-Ks)_{VSp}"\n%;
    print GP qq%set xlabel "Ks_{VSp}"\n%;
    print GP qq%plot [8:16][-.5:.5]  "$i.g" u $posKV:((\$$posJS-\$$posKS)-(\$$posJV-\$$posKV)) ps .4 pt 2 lc 2 ti "err!=0", "$is" u $posKV:((\$$posJS-\$$posKS)-(\$$posJV-\$$posKV))  pt 1 lc 1 ti "calib stars", 0.02 lc 3, -0.02lc 3\n%;
    print GP qq%set xlabel "(J-Ks)_{STD}"\n%;
    print GP qq%plot [$JKsplotrange][-.5:.5]  "$i.g" u (\$$posJS-\$$posKS):((\$$posJS-\$$posKS)-(\$$posJV-\$$posKV)) ps .4 pt 2 lc 2 ti "err!=0", "$is" u (\$$posJS-\$$posKS):((\$$posJS-\$$posKS)-(\$$posJV-\$$posKV))  pt 1 lc 1 ti "calib stars", 0.02 lc 3, -0.02 lc 3\n%;
####
    print GP qq%set ylabel "(J-H)_{STD}-(J-H)_{VSp}"\n%;
    print GP qq%set xlabel "Ks_{VSp}"\n%;
    print GP qq%plot [8:16][-.5:.5]  "$i.g" u $posKV:((\$$posJS-\$$posHS)-(\$$posJV-\$$posHV)) ps .4 pt 2 lc 2 ti "err!=0", "$is" u $posKV:((\$$posJS-\$$posHS)-(\$$posJV-\$$posHV))  pt 1 lc 1 ti "calib stars", 0 noti, 0.02, -0.02\n%;
    print GP qq%set xlabel "(J-H)_{STD}"\n%;
    print GP qq%plot [$JHplotrange][-.5:.5]  "$i.g" u (\$$posJS-\$$posHS):((\$$posJS-\$$posHS)-(\$$posJV-\$$posHV)) ps .4 pt 2 lc 2 ti "err!=0", "$is" u (\$$posJS-\$$posHS):((\$$posJS-\$$posHS)-(\$$posJV-\$$posHV))  pt 1 lc 1 ti "calib stars", 0.02 lc 3 , -0.02 lc 3\n%;
####
    print GP qq%set ylabel "(H-Ks)_{STD}-(H-Ks)_{VSp}"\n%;
    print GP qq%set xlabel "Ks_{VSp}"\n%;
    print GP qq%plot [8:16][-.5:.5]  "$i.g" u $posKV:((\$$posHS-\$$posKS)-(\$$posHV-\$$posKV)) ps .4 pt 2 lc 2 ti "err!=0", "$is" u $posKV:((\$$posHS-\$$posKS)-(\$$posHV-\$$posKV))  pt 1 lc 1 ti "calib stars", 0.02 lc 3, -0.02 lc 3\n%;
    print GP qq%set xlabel "(H-Ks)_{STD}"\n%;
    print GP qq%plot [$HKsplotrange][-.5:.5]  "$i.g" u (\$5-\$7):((\$5-\$7)-(\$11-\$13)) ps .4 pt 2 lc 2 ti "err!=0", "$is" u (\$$posHS-\$$posKS):((\$$posHS-\$$posKS)-(\$$posHV-\$$posKV))  pt 1 lc 1 ti "calib stars", 0.02 lc 3, -0.02 lc 3\n%;
####
####
    print GP qq%set ylabel "J_{STD}-J_{VSp}"\n%;
    print GP qq%set xlabel "(J-Ks)_{STD}"\n%;
    print GP qq%plot [$JKsplotrange][-.5:.5]  "$i.g" u (\$$posJS-\$$posKS):(\$$posJS-\$$posJV) ps .4 pt 2 lc 2 ti "err!=0", "$is" u (\$$posJS-\$$posKS):(\$$posJS-\$$posJV)  pt 1 lc 1 ti "calib stars", 0.02 lc 3, -0.02 lc 3\n%;
    print GP qq%plot [$JKsplotrange][-.5:.5]  "$i.g" u (\$$posJS-\$$posKS):(\$$posJS-\$$posJV) lc 1 noti, "$i.b" u (\$$posJS-\$$posKS):(\$$posJS-\$$posJV) ps .5 lc 2 noti, 0.02 lc 3, -0.02 lc 3\n%;
    print GP qq%set xlabel "J_{VSp}"\n%;
    print GP qq%plot [8:17][-.5:.5]  "$i.g" u $posJV:(\$$posJS-\$$posJV) ps .4 pt 2 lc 2 ti "err!=0", "$is" u $posJV:(\$$posJS-\$$posJV) pt 1 lc 1 ti "calib stars", 0.02 lc 3, -0.02 lc 3\n%;
####
    print GP qq%set xzeroaxis lt -1 lw .3 \n%;
    print GP qq%set multiplot\n%;
    print GP qq%set pm3d map\nset palette color negative\n%;
    print GP qq%splot [8:17][-.5:.5] "$tmpJ.fr" u 1:2:(log10(\$3)) noti\n%;
    print GP qq%unset pm3d\n%;
    print GP qq%splot [8:17][-.5:.5] "$tmpJ" w l lc 0  lt 2 lw .5 noti,"$tmpH" w l lc 0 lt 2 lw .5 noti\n%;
    print GP qq%unset multiplot\n%;
    print GP qq%set xzeroaxis lt -1\n%;
#    print GP qq%set ylabel "J_{STD}-J_{VSp}"\n%;
    print GP qq%plot [8:17][-.5:.5]  "$i.g" u $posJV:(\$$posJS-\$$posJV) lc 1 noti, "$i.b" u $posJV:(\$$posJS-\$$posJV) lc 2 ps .5 noti, 0.02 lc 3, -0.02 lc 3\n%;
    print GP qq%set ylabel "J_{STD}-J_{VSp} -Ex_J"\n%;
    print GP qq%plot [8:17][-.5:.5]  "$i.g" u $posJV:(\$$posJS-\$$posJV-\$$posJE) ps .4 pt 2 lc 2 ti "err!=0", "$is" u $posJV:(\$$posJS-\$$posJV-\$$posJE) pt 1 lc 1 ti "calib stars"\n%;
    print GP qq%set xlabel "theorical Ex_J in $radexc arcsec"\n%;
    print GP qq%plot [-2:][-2:2]  "$i.g" u $posJE:(\$$posJS-\$$posJV) ps .4 pt 2 lc 2 ti "err!=0", "$is" u $posJE:(\$$posJS-\$$posJV) pt 1 lc 1 ti "calib stars", x noti\n%;
    print GP qq%plot [-2:][-2:2]  "$i.g" u $posJE:(\$$posJS-\$$posJV) lc 1 noti,  "$i.b" u $posJE:(\$$posJS-\$$posJV) lc 2 ps .5 noti, x noti\n%;
####
####
    print GP qq%set ylabel "H_{STD}-H_{VSp}"\n%;
    print GP qq%set xlabel "(J-Ks)_{STD}"\n%;
    print GP qq%plot [$JKsplotrange][-.5:.5]  "$i.g" u  (\$$posJS-\$$posKS):(\$$posHS-\$$posHV) ps .4 pt 2 lc 2 ti "err!=0", "$is" u (\$$posJS-\$$posKS):(\$$posHS-\$$posHV) pt 1 lc 1 ti "calib stars", 0.02 lc 3, -0.02 lc 3\n%;
    print GP qq%plot [$JKsplotrange][-.5:.5]  "$i.g" u (\$$posJS-\$$posKS):(\$$posHS-\$$posHV) lc 1 noti, "$i.b" u (\$$posJS-\$$posKS):(\$$posHS-\$$posHV) lc 2 ps .5 noti, 0.02 lc 3, -0.02 lc 3\n%;
    print GP qq%set xlabel "H_{VSp}"\n%;
    print GP qq%plot [8:16][-.5:.5]  "$i.g" u $posHV:(\$$posHS-\$$posHV) ps .4 pt 2 lc 2 ti "err!=0", "$is" u $posHV:(\$$posHS-\$$posHV) pt 1 lc 1 ti "calib stars",  0.02 lc 3, -0.02 lc 3\n%;
    print GP qq%set xzeroaxis lt -1 lw .3 \n%;
    print GP qq%set multiplot\n%;
    print GP qq%set pm3d map\nset palette color negative\n%;
    print GP qq%splot [8:16][-.5:.5] "$tmpH.fr" u 1:2:(log10(\$3)) noti\n%;
    print GP qq%unset pm3d\n%;
    print GP qq%splot [8:16][-.5:.5] "$tmpJ" w l lc 0  lt 2 lw .5 noti,"$tmpH" w l lc 0 lt 2 lw .5 noti\n%;
    print GP qq%unset multiplot\n%;
    print GP qq%set xzeroaxis lt -1\n%;
#    print GP qq%set ylabel "H_{STD}-H_{VSp}"\n%;
    print GP qq%plot [8:16][-.5:.5]  "$i.g" u $posHV:(\$$posHS-\$$posHV) lc 1 noti, "$i.b" u $posHV:(\$$posHS-\$$posHV) lc 2 ps .5 noti, 0.02 lc 3, -0.02 lc 3\n%;
    print GP qq%set ylabel "H_{STD}-H_{VSp} -Ex_{H}"\n%;
    print GP qq%plot [8:16][-.5:.5]  "$i.g" u $posHV:(\$$posHS-\$$posHV-\$$posHE) ps .4 pt 2 lc 2 ti "err!=0", "$is" u $posHV:(\$$posHS-\$$posHV-\$$posHE) pt 1 lc 1 ti "calib stars"\n%;
    print GP qq%set xlabel "theorical Ex_H in $radexc arcsec"\n%;
    print GP qq%plot [-2:][-2:2]  "$i.g" u $posHE:(\$$posHS-\$$posHV) ps .4 pt 2 lc 2 ti "err!=0", "$is" u $posHE:(\$$posHS-\$$posHV) pt 1 lc 1 ti "calib stars",   x noti\n%;
    print GP qq%plot [-2:][-2:2]  "$i.g" u $posHE:(\$$posHS-\$$posHV) lc 1 noti,  "$i.b" u $posHE:(\$$posHS-\$$posHV) lc 2 ps .5 noti, x noti\n%;
####
####
    print GP qq%set ylabel "Ks_{STD}-Ks_{VSp}"\n%;
    print GP qq%set xlabel "(J-Ks)_{STD}"\n%;
    print GP qq%plot [$JKsplotrange][-.5:.5]  "$i.g" u (\$$posJS-\$$posKS):(\$$posKS-\$$posKV) ps .4 pt 2 lc 2 ti "err!=0", "$is" u (\$$posJS-\$$posKS):(\$$posKS-\$$posKV) pt 1 lc 1 ti "calib stars", 0.02 lc 3, -0.02 lc 3\n%;
    print GP qq%plot [$JKsplotrange][-.5:.5]  "$i.g" u (\$$posJS-\$$posKS):(\$$posKS-\$$posKV) lc 1 noti,  "$i.b" u (\$$posJS-\$$posKS):(\$$posKS-\$$posKV) lc 2 ps .5 noti, 0.02 lc 3, -0.02 lc 3\n%;
    print GP qq%set xlabel "Ks_{VSp}"\n%;
    print GP qq%plot [8:16][-.5:.5]  "$i.g" u $posKV:(\$$posKS-\$$posKV) ps .4 pt 2 lc 2 ti "err!=0", "$is" u $posKV:(\$$posKS-\$$posKV) pt 1 lc 1 ti "calib stars",  0.02 lc 3, -0.02 lc 3\n%;
    print GP qq%set xzeroaxis lt -1 lw .3 \n%;
    print GP qq%set multiplot\n%;
    print GP qq%set pm3d map\nset palette color negative\n%;
    print GP qq%splot [8:16][-.5:.5] "$tmpK.fr" u 1:2:(log10(\$3)) noti\n%;
    print GP qq%unset pm3d\n%;
    print GP qq%splot [8:16][-.5:.5] "$tmpJ" w l lc 0  lt 2 lw .5 noti,"$tmpH" w l lc 0 lt 2 lw .5 noti\n%;
    print GP qq%unset multiplot\n%;
    print GP qq%set xzeroaxis lt -1\n%;
#    print GP qq%set ylabel "Ks_{STD}-Ks_{VSp}"\n%;
    print GP qq%plot [8:16][-.5:.5]  "$i.g" u $posKV:(\$$posKS-\$$posKV) lc 1 noti, "$i.b" u $posKV:(\$$posKS-\$$posKV) lc 2 ps .5 noti, 0.02 lc 3, -0.02 lc 3\n%;
    print GP qq%set ylabel "Ks_{STD}-Ks_{VSp} -Ex_{Ks}"\n%;
    print GP qq%plot [8:16][-.5:.5]  "$i.g" u $posKV:(\$$posKS-\$$posKV-\$$posKE) ps .4 pt 2 lc 2 ti "err!=0", "$is" u $posKV:(\$$posKS-\$$posKV-\$$posKE) pt 1 lc 1 ti "calib stars"\n%;
    print GP qq%set xlabel "theorical Ex_{Ks} in $radexc arcsec"\n%;
    print GP qq%plot [-2:][-2:2]  "$i.g" u $posKE:(\$$posKS-\$$posKV) ps .4 pt 2 lc 2 ti "err!=0", "$is" u $posKE:(\$$posKS-\$$posKV) pt 1 lc 1 ti "calib stars",  x noti\n%;
    print GP qq%plot [-2:][-2:2]  "$i.g" u $posKE:(\$$posKS-\$$posKV) lc 1 noti, "$i.b" u $posKE:(\$$posKS-\$$posKV) lc 2 ps .5 noti, x noti\n%;
####
####
    print GP qq%set ylabel "dec"\nset xlabel "ra"\nplot "${i}-rej" ps .3 ti "unmatched STD stars"\nset xtics -$cmpmaxdist,.1\n%;
    print GP qq%set logscale y\nset ylabel "N_{star}/area"\nset xlabel "{/Symbol D}r [arcsec]"\n%;
    print GP qq%plot "$i.rfr"  u 1:((\$2/(2*pi*.05*\$1))) w l ti "{/Symbol D}r", "$i.xfr" u 1:((\$2/(.05*2))) w l ti "{/Symbol Da}", "$i.yfr" u 1:((\$2/(.05*2))) w l ti "{/Symbol Dd}"\n%;
    close GP;

    unlink "$i.xfr", "$i.yfr", "$i.rfr", "$i.b", "$i.g", "$tmpJ", "$tmpJ.fr", "$tmpH", "$tmpH.fr", "$tmpK", "$tmpK.fr";

    push @totar, "STD-${idxwntk}.ps";
    }
#############ReUnioning################
@elit=sort keys %t_o;
for my $tok(sort keys %t_o){
  my(@tfam_ty)=();
  print "Tile $tok =>\n";

  for my $tfok(sort (split m.\s+., $t_tfam{$tok})){
    my $tfo=$tfok; $tfo=~s/_/ /g; $fmst=(split m._.,$tfok)[1];
    print "\tFamily $tfo =>\n";

    for my$iii(0..$#fff){print "Filter $fff[$iii]:  ";
      my($no,@no)=();
      unlink "${workname}_${tfok}_$fff[$iii].mag","${workname}_${tfok}_$fff[$iii].raw","${workname}_${tfok}_$fff[$iii].cor";
      my@l=();
      for my$fcok(sort keys %fco_){
        my@kh=(split /\s+/,$fov_flt{"$tfo $fcok $fff[$iii]"});
        if(@kh){
          push @l,@kh;
          push @no,scalar(@kh);
        }
      }
      print join "\x20\x20\x20",@l,"\n";
      $no=$no[0];  for my$m(@no){ $no=$m if($no>$m); }
      if(@l>1){
        my$noo=$no; $noo=2 if($no==3); ($no,$noo)=(3,3) if($no>3);
        my ($mch, $flag, $sigma, @files)=("${workname}_${tfok}_$fff[$iii].mch", "$noo,.15,$no", 3, @l);
        $mch=~s/ /_/g;
          print "$flag $sigma\n";
        unlink "${workname}_${tfok}_$fff[$iii].mag", "${workname}_${tfok}_$fff[$iii].cor", "${workname}_${tfok}_$fff[$iii].raw";
        open(MM,"|${pathdir}VVV-DoMatch.pl");print MM "$mch 1 $flag $sigma 2  reu ", join (" ", @files, "\n");print MM "$mch 0 $flag $sigma 2  reu ", join (" ", @files, "\n");close MM;
        open(MCH, $mch);while(<MCH>){s/\x27//g;my@qaz=split; print sprintf("%s  %+.4f\n",$qaz[0], $qaz[7]);}close MCH;
      }elsif(@l==1){
        unlink "${workname}_${tfok}_$fff[$iii].mag";
        symlink $l[0], "${workname}_${tfok}_$fff[$iii].mag";
        print "\t==> ${workname}_${tfok}_$fff[$iii].mag\n";
      }else{next;}

      if($fff[$iii]=~/J|H|K/ && ($fff[$iii]=~/($filterstdcat)/)){
        unlink "${workname}_${tfok}_$fff[$iii].cal", "${workname}_${tfok}_$fff[$iii].stdat", "${workname}_${tfok}_$fff[$iii].magold";
        my@dfshg=split m.:.,$magcut[$filterstdcat{$fff[$iii]}];
        my$zxpo=$zxpo[$filterstdcat{$fff[$iii]}]+0;
        `${pathdir}stdVVVcleanNout $stdcat ${workname}_${tfok}_$fff[$iii].mag $plmn[0] $plmn[1] $stdcut $dfshg[0] $dfshg[1] $filterstdcat{$fff[$iii]} 0 $zxpo ${workname}_${tfok}_$fff[$iii]`;

        my (@q,@b);
 
        print "\nCorrecting for a constant shift:\n";
        if($calpar{"${workname}_${tfok}_$fff[$iii].mag"}){
          print "Using given calibrating parameters: ".$calpar{"${workname}_${tfok}_$fff[$iii].mag"}."\n";
          @b=(split ' ',$calpar{"${workname}_${tfok}_$fff[$iii].mag"});
        }else{
          print "", @q=`${pathdir}vvvpbswlsqfit_erry  ${workname}_${tfok}_$fff[$iii].cal 1   $coeffpbsf[$iii]   `, "\n";
          @b=((split ' ',$q[4])[1..2]); $b[1]=0;
        }
 
        print CALF join "  ", "${workname}_${tfok}_$fff[$iii].mag", @b,"\n";
        `${pathdir}calibVVV ${workname}_${tfok}_$fff[$iii] 1 0 $b[0] 0 0 0 `;
        rename "${workname}_${tfok}_$fff[$iii].mag", "${workname}_${tfok}_$fff[$iii].magold";
        rename "${workname}_${tfok}_$fff[$iii].mag_cal", "${workname}_${tfok}_$fff[$iii].mag";
        print "\t==> ${workname}_${tfok}_$fff[$iii].mag\n";
      }
  print "\n\n";
    }
  print "\n\n";

  WAIT:
  $prewait=time;
  while(-e "WAIT" || -e "${scriptname}.WAIT"){    sleep 10;  }
  if(-e "STOP" || -e "${scriptname}.STOP"){
unlink $lockfile;
 die "!!!Obbedisco!\n\n";}
  $start+=time-$prewait;

  ##Doing the catalogue
    $idxwntk="${workname}_${tfok}";
    {
    $mchmd="match";
    my ($mch, $flag, $sigma, @files)=("${workname}_${tfok}_", "2,.15,2", 5);$mch=~s/ /_/g;
    for my$fff(@fff){if(-e "${workname}_${tfok}_${fff}.mag"){$mch.=$fff; push @files, "${workname}_${tfok}_${fff}.mag";$tflt{$tok}.=$fff if(!($tflt{$tok}=~/$fff/));}}$mch.=".mch";
    $flag="3,.5,3" if(@files>4);
    print "$flag $sigma\n";
    ($rraww=$mch)=~s/mch$//;
    unlink "${rraww}raw", "{$rraww}mag", "${rraww}tfr", "${rraww}cor", "${rraww}Ctlg";
    open(MM,"|${pathdir}VVV-DoMatch.pl");print MM "$mch 1 $flag $sigma 2  reu ", join (" ", @files, "\n");print MM "$mch 0 $flag $sigma 2  reu ", join (" ", @files, "\n");close MM;
    unlink "${rraww}mag", "${rraww}tfr", "${rraww}cor";
    {
    my@qazwsx=(split m.\s+.,$tfam_f{$tfok});
    $hjkl=1E6;
    for my $f (@qazwsx){
      my $z=`${pathdir}xy2sky $f.fits 0 0`;
      $z=`${pathdir}sky2xy $qazwsx[0].fits $z`;
      my@zzz=(split /\s+/, $z)[4,5];
      ($hjkl,$tyuiop)=($zzz[0],$f) if($hjkl>$zzz[0]);
    }
    push @tfam_ty, $tyuiop;
    `sort -gu -k 1 $qazstdat{$tfok} > $idxwntk.stdat`;
    }


    &BuildCtlg();$tstc{$tok}.="${rraww}Ctlg ";
    &PlotDmCMD();
    &TooMASScmpplot();

     }
      print "\n\n\n";
  }

