def VVVMetrCalibMatch():
  """
""";
  _name_='VVVMetrCalibMatch';
  startime=funct.startime();
  (pathscript, scriptname, scriptype)=funct.scriptdefine();
  if(scriptname==None): scriptname=_name_;

  startime+=funct.WaitStop([scriptname]);





  Metrdatafile="VVV-metr";
  calibfile="VVV-calib";
  calpar={};
  tyuiop=None;
  rraww=None;
  idxwntk=None;
  filterL=["J","H","Ks","Y","Z"];
  filterD={"J":0, "H":1, "Ks":2, "Y":3, "Z":4);

  #skzmagcorr=0;
  #zeropoint="17.39,16.93,16.40";

#STD catalog
  par.SkZp_Opt['S']['stdcat']="";
  par.SkZp_Opt['L']['stdposcoomag']=[];
  par.SkZp_Opt['L']['filterstdcat']=[];
  par.SkZp_Opt['L']['stdcut']=[2.2,.34,.03];
  par.SkZp_Opt['LT']['magcut']=[(11.5,13.5), (11.5,13.0), (10.5,12.5)];
  par.SkZp_Opt['L']['magcutdef']=[9,14.5];
  notsamecol=0;      #use the same magnitude in the color for the calibration/the same color for all the calibration
  par.SkZp_Opt['L']['coeffpbs']=[2, 2, 4];  #global value of -a +a b
  coeffpbsfL=[];
  coeffpbsf="";

#metrVVVsel
  alfsuff="alf";
  alfsuffcl=alfsuff+"M";
  alfclean=1;   ## 0 no cleaning; 1 clean; -1 not run the program and get recovered stars
  cleanway=1;   ## 0 only sigma clip; >0 also empiric
  mggm={"Jb":.6, "Hb":.23, "Ksb|Ksd...v":-.64, "Jd":1.2, "Hd":1.25, "Ksd": .45};  #mean zeropoint of the calibration for metrVVVsel
  sigmacliprej=3;
  cleanratio=.2;
  regflag=-1;
  framerem=1;   ## 0 to keep the frame, 1 to remove the whole frame, -1 to remove only upper and lower part
  chicutrej=8;
  alfsuffrej=alfsuffcl+"rej";
  alfsuffrec=alfsuffcl+"rec";

#Building the Ctlg &C
  par.SkZp_Opt['S']['VVVmatch']="union"; #"match";
  wantedfilter="";
  par.SkZp_Opt['F']['denmapbin']=88;
  par.SkZp_Opt['I']['denmap_nx']=0;
  par.SkZp_Opt['I']['denmap_ny']=0;
  par.SkZp_Opt['F']['denmapmaglim']=17.5;
  widthcolor=0.04;
  JKsplotrange="-1:5";
  JHplotrange="-1:4";
  HKsplotrange="-1:3";
  sigmaclipSTD=0;

  #START
  funct.InputDataInitialize(optfiles=[scriptname+".opt"], select='catalog');
  DpAls.SetSkZp_Opt();


die "!!!Error: problems with the list of filter in the standard catalog ($filterstdcat)\n" if(!$filterstdcat);
my@spcm=split ',',$stdposcoomag;
die "!!!Error: problems with the list of position of coordinates and magnitudes in the standard catalog ($stdposcoomag)\n" if($spcm[0]>=$spcm[1]);
  $calfile=$workname.".calpar";
my($nfltrstd,$lpfs)=0;
if($filterstdcat==3){$nfltrstd=$filterstdcat; $filterstdcat="J,H,Ks";}
if($filterstdcat==5 || $filterstdcat==-3){ $nfltrstd=$filterstdcat; $filterstdcat="J,H,Ks,Y,Z";}
my@filterstdcat=split m.,.,$filterstdcat;
$nfltrstd=@filterstdcat if(!$nfltrstd);
my%filterstdcat;
for my$i(0..$#filterstdcat){$filterstdcat{$filterstdcat[$i]}=$i;}
($lpfs=$filterstdcat)=~s/(\w+)/$fff{$1}/g;
$filterstdcat=~s.,.|.g;

$alfclean=0 if($alfclean=~/n/);
  $radexc=(split m.,.,$stdcut)[0];
$stdcut=~s.,. .g;
my@magcut=split m.,.,$magcut;
if(@magcut<@filterstdcat){
  for(my$ii=@magcut; $ii<@filterstdcat; $ii++){
  $magcut[$ii]=$magcutdef;
  }
}
@coeffpbsf=split ':',$coeffpbsf;
for my$i(0..$#fff){$coeffpbsf[$i]=$coeffpbs if(!$coeffpbsf[$i]); $coeffpbsf[$i]=~s.,. .g;}
#$skzmagcorr=0 if($skzmagcorr=~/n/);
#my@zxpo=split m.,.,$zeropoint;
#@zxpo=(0,0,0) if($skzmagcorr==0);
#my(@zxpoc)=@zxpo;
#@zxpoc=(0,0,0) if($skzmagcorr==-1);
  zxpoc=[0,0,0];

if($wantedfilter){
  if($wantedfilter=~m.,.){
    my@wantedfilter=split ',',$wantedfilter;
    $wantedfilter="";
    for my $wf(@wantedfilter){ $wantedfilter.=$fff{$wf}.",";}
    chop $wantedfilter;
  }
}else{
  $wantedfilter=-1;
}

select((select(STDOUT),$|=1)[0]);

if(!-e $stdcat){die "!!!Error: problems with the catalogue $stdcat\n";}else{print"Using the standard catalog: $stdcat\n";}

$notsamecol=1 if($notsamecol=~/^y/);
$notsamecol=0 if($notsamecol=~/^n/);
if($notsamecol!=0 && $notsamecol!=1){die "!!!Error: the value of $notsamecol is wrong!\n";}


if(-e $lockfile){die "!!!Error: it seems that there is already a VVV-SkZ_pipeline running in this directory!\n";}else{open(LCK,">$lockfile");print LCK $lock=1;close LCK;}
my@lstimg;
if($alfclean==-1 && !-e "${workname}-dat"){
    unlink $lockfile;
    die "!!!Error: You ask to not re-execute the astrometrizing program but it's not already runned!\n";
}
if($alfclean!=-1){
open(DT, ">$Metrdatafile") or die "!!!Error: problems opening $Metrdatafile\n";
open(FIN, $imgdatafile) or die "\n!!!Error: There is not the file $imgdatafile\n";
print "\nAstrometrizing[$cleanway $sigmacliprej]...\n";
$sigmacliprej=$sigmacliprej+1.;
while(<FIN>){
  next if(/^#/);
  chomp;
  my @t=split;
  if(!-e "$t[0].$alfsuff"){
    unlink $lockfile;
    die "!!!Error: $t[0].$alfsuff doesn't exist!\n";
  }
  push @lstimg,$t[0];

  my$mpos=$filterstdcat{$t[4]}; $mpos=-1 if(!(defined $mpos));

#produced input data for metrVVVsel
  my$datfn="${workname}:$t[-4]:$t[-5]:$t[2]:$t[-2]";
  my$fltob=$t[4].$t[-4];my$zzpp;
  ASDF:for my$keyk (keys %mggm){
  if($fltob=~/$keyk/){
  $zzpp=$mggm{$keyk}; last ASDF;
  }
  }
  $zzpp=1 if(!(defined $zzpp));

  print DT join(" \x20 ", "$t[0].$alfsuff", $mpos, $zzpp, $sigmacliprej, $chicutrej, "$datfn"),"\n";
  $datfn="${workname}_$t[-4]_$t[-5]_$t[2]_$t[-2].$t[4]-dat";
  unlink $datfn, "$t[0].${alfsuffcl}-dat";
  symlink "$t[0].${alfsuff}-dat", $datfn;
  symlink "$t[0].${alfsuff}-dat", "$t[0].${alfsuffcl}-dat";

#produced fn.radec for metrVVVsel
  my@nxny; open(ALF,"$t[0].$alfsuff");
  $_=<ALF>;$_=<ALF>;@nxny=(split)[1,2];
  open(CRN, ">$t[0].xy"); ($nxny[2],$nxny[3])=($framerem==0)?(0,0): ($framerem>0)? (60,60): (0,60);
  $nxny[0]-=$nxny[2];$nxny[1]-=$nxny[3];
  print CRN sprintf("%10.4f %10.4f\n%10.4f %10.4f\n%10.4f %10.4f\n%10.4f %10.4f\n",@nxny[2,3,0,3,0,1,2,1]);  #$nxny[2], $nxny[3],$nxny[0], $nxny[3], $nxny[0], $nxny[1],$nxny[2],$nxny[1]);
  $_=<ALF>;
  while(<ALF>){@nxny=(split)[1,2]; print CRN sprintf("%10.4f %10.4f\n",$nxny[0],$nxny[1]);}
  close ALF;close CRN;
  `${pathdir}xy2sky -d $t[0].fits "@"$t[0].xy > $t[0].radec`;
  }
close FIN; close DT;
}

  ($hjkl,@plmn, @plmx, $plan)=(360);
{my (@tq, @clnps);
    push @clnps, qq%set terminal postscript enhanced color\nset output "${workname}_clean.ps"\n%;
  $crnr="$workname.crnr";

$prewait=time;
while(-e "WAIT" || -e "${scriptname}.WAIT"){  sleep 10;}
die "!!!Obbedisco!\n\n" if(-e "STOP" || -e "${scriptname}.STOP");
$start+=time-$prewait;

###Astrometrizing here!
if($alfclean!=-1){
  unlink "${workname}-dat";
  `${pathdir}metrVVVsel $Metrdatafile $framerem $cleanway $cleanratio $regflag $stdcat $stdposcoomag,$nfltrstd,$lpfs ${workname}STD.stdcat ${workname}-dat`;
  print "$? ",$?>>8,"\n",`date`;
