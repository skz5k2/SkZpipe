      ($hjkl,$tyuiop)=($zzz[1],$f) if($hjkl>$zzz[1]);
    }
    push @t_ty, $tyuiop;
    my$qazstdat="";
    for my$tadts(@skffamo){$qazstdat.="${workname}_$tadts.stdat ";}
    `sort -gu -k 1 $qazstdat > $idxwntk.stdat`;
    }
