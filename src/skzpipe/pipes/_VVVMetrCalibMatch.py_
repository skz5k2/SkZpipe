    if($regflag<0){unlink glob("*.$alfsuff.frm.reg"), glob("*.$alfsuffcl.reg"),glob("*.$alfsuffrej.reg");}}
  `tar -cjf ${workname}-dat.tar.bz2 ${workname}-dat *.${alfsuff}-dat`;
}
  open(DAT,"${workname}-dat");
  $_=<DAT>;@plmn=(split)[-2,-1];s._. .g;print;
  $_=<DAT>;@plmx=(split)[-2,-1];s._. .g;print;
  $_=<DAT>;$plan=(split)[-2];s._. .g;print;print"\n";
close DAT;
$stdcat="${workname}STD.stdcat";
$stdposcoomag="1,3";
open(FIN, $imgdatafile) or die "\n!!!Error: There is not the file $imgdatafile\n";
while(<FIN>){
  next if(/^#/);
  chomp;
 my($fn,$filter)=(split)[0,4];
  unlink "$fn.radec";

  my $mn=(-e "${fn}.${alfsuffcl}") ? `${pathdir}file_stat -lqn  ${fn}.${alfsuffcl}` : 0;
  if($mn<4){
    print "!!!Error: file ${fn}.${alfsuffcl} has no stars or doesn't exist! Something wrong in the previous step. Quitting!\n\[$mn\]\n";
    goto EENDD;
  }
  open(DAT,"${fn}.${alfsuffcl}-dat");
  while(<DAT>){last if(/#zp/)}
  my($zpfn, $afn, $bfn, $cfn, $kfn)=(split)[2..6];
  close DAT;
    push @clnps, qq%set title "$fn"\nset xlabel "X"\nset ylabel "Y"\nplot [][] "${fn}.$alfsuffcl" u 2:3 ps .1 ti "kept", "${fn}.$alfsuffrej" u 2:3 ps .1 lc 3 ti "rejected", "${fn}.$alfsuff.frm" u 2:3 ps .1 lc 2 ti "removed"\n%.
qq%set xlabel "$filter"\nset ylabel "Log10 err $filter"\nset grid\n%.
qq%plot [7:25][-2.75:1.5] "${fn}.$alfsuffcl" u 4:(log10(\$5)) ps .1 ti "kept", "${fn}.$alfsuffrej" u 4:(log10(\$5)) ps .1 lc 3 ti "rejected", "${fn}.$alfsuff.frm" u 4:(log10(\$5)) ps .1 lc 2 ti "removed",%.
qq% $bfn*((.4*(x-$zpfn))**4+1+$afn)**.25-3+$cfn lc 3 lt 1 ti "$zpfn $afn $bfn $cfn : $kfn", %.   ##%##
qq% $bfn*((.4*(x-$zpfn))**4+1+$afn)**.25-3+$cfn lc 3 lt 1 noti, $bfn*((.4*(x-$zpfn))**4+1+$afn)**.25-3+$cfn+log10($sigmacliprej) lt 2 lc 5 noti\n%.
qq%set ylabel "Chi2"\nplot [7:25][:15] "${fn}.$alfsuffcl" u 4:8 ps .1 ti "kept", "${fn}.$alfsuffrej" u 4:8 ps .1 lc 3 ti "rejected", "${fn}.$alfsuff.frm" u 4:8 ps .1 lc 2 ti "removed"\nunset grid\n%;
  }
close FIN;
open(CLNGP, ">${workname}_clean.gp"); print CLNGP @clnps; close CLNGP;   ##%##
open(GPLT,"|gnuplot"); print GPLT @clnps; close GPLT;
}


  (%regroup,%datahash,%obfov,%obj,%cal,%o_t,%t_tfam,%tfam_o,%t_o,%fov_flt,%tfam_f,%t_f,@calps,%qazstdat)=();
    push @calps, qq%set terminal postscript enhanced monochrome\nset output "${workname}_cal.ps"\n%;

if(-e $calibfile){
