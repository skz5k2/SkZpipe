      }
    }print "\n";
    ##Doing the catalogue
    {
      my ($mch, $flag, $sigma, @files)=("${workname}_${tok}_", "2,.15,2", 5);
      for my$fff(@fff){$mch.=$fff and push @files, "${workname}_${tok}_${fff}.mag" if(-e "${workname}_${tok}_${fff}.mag");}$mch.=".mch";
      $flag="3,.5,3" if(@files>4);
      print "$flag $sigma\n";
      ($rraww=$mch)=~s/mch$//;
      unlink "${rraww}mag", "${rraww}tfr", "${rraww}cor", "${rraww}raw", "${rraww}Ctlg";
      open(MM,"|${pathdir}VVV-DoMatch.pl");print MM "$mch 1 $flag $sigma 2  reu ", join (" ", @files, "\n");print MM "$mch 0 $flag $sigma 2  reu ", join (" ", @files, "\n");close MM;
      unlink "${rraww}mag", "${rraww}tfr", "${rraww}cor" if(!$debug);
    }
  }elsif($stripematch=~/union/){
   $rraww="${workname}_${tok}_".$tflt{$tok}.".";
   $tttt=$tok;
   print "$tstc{$tok} => ${rraww}Ctlg";
   $mchmd="union";
  }

    $idxwntk="${workname}_${tok}";
    {
    $hjkl=1E6;
    for my $f (@tfam_ty){
