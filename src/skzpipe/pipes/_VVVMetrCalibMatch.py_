      $z=`${pathdir}sky2xy $t_ty[0].fits $z`;
      my@zzz=(split /\s+/, $z)[4,5];
      ($hjkl,$tyuiop)=($zzz[1],$f) if($hjkl>$zzz[1]);
    }
    my$qazstdat="";
    for my$tadts(@elit){$qazstdat.="${workname}_$tadts.stdat ";}
    `sort -gu -k 1 $qazstdat > $idxwntk.stdat`;
