  if(-e "STOP" || -e "${fn}.STOP" || -e "${scriptname}.STOP"){
unlink $lockfile;
 die "!!!Obbedisco!\n\n";}
  if(-e "${fn}.SKIP"){    print "\nSkip to the next image"; goto END;  }
  $start+=time-$prewait;

  {
      my $size=(-e "${fn}.$alfsuffcl") ? `${pathdir}file_stat -lqn "${fn}.$alfsuffcl"` : 0;
      if(!-e "${fn}.$alfsuffcl" || $size<4 ){
        print "\nError: file ${fn}.$alfsuffcl is empty or doesn't exist! Skip to the next image";
        goto END;
      }
my($s,$a);
    if($alfclean==0){
      `cat ${fn}.$alfsuffrej >> ${fn}.$alfsuffcl`;
    }elsif($alfclean==-1 && -e "$fn.$alfsuffrec"){
      `cat ${fn}.$alfsuffrec >> ${fn}.$alfsuffcl`;
    }

    print "$fn.$alfsuff [", $a=`${pathdir}file_stat -lqn "${fn}.$alfsuff"`-3,"]=>[",   $s=`${pathdir}file_stat -lqn  "${fn}.$alfsuffcl"`-3, "](", $s-$a,")\n";

    #my @out_fn=("$fn.std", "$fn.xy", "$fn.stdxy", "$fn.stdat", "${fn}_cal.mch", "${fn}_cal.raw", "${fn}.cal");
    my @out_fn=("$fn.std", "$fn.xy", "$fn.stdxy", "$fn.stdat", "${fn}.cal");
    for(my $i=0; $i<@out_fn; $i++){
      -e $out_fn[$i] and unlink $out_fn[$i];
    }
  }



  $datahash{$fn}=$_;
  my($fam, $obname, $tile, $offset)=($input[-5], $input[-4], $input[-3], $input[-2]);
  $fam=ord($fam)-ord("a")+1 if($fam=~/[a-h]/);
  my
  my $kkey=$tile."_".$fam;
  if(!($tfam_o{$kkey}=~/$kkey/)){$tfam_o{$kkey}.=$obname." ";}
  $tfam_f{$kkey}.=$fn." ";
  $t_f{$tile}.=$fn." ";
  if(!($t_tfam{$tile}=~/$kkey/)){$t_tfam{$tile}.=$kkey." ";}
  $obfov{"$obname $fam $chp $offset"}.="$fn ";
  $o_t{$obname}=$tile; #Which tile is an OB
  if(!($t_o{$tile}=~/$obname/)){$t_o{$tile}.=$obname." ";}
  if(!($obj{$obname}=~/$offset/)){$obj{$obname}.=$offset." ";}


  print "=> $fn [$filter] :\n";

  if(($filter=~/($filterstdcat)/)){
  my (@q,@b);

 STD:
  print "Finding stars for calibration ";
  print "with SkZ-magnitude correction "if($skzmagcorr);
  print "... ";
  my $cmd;
  $cmd=`${pathdir}file_stat -lqn  $fn.stdcat`;
#  my(@fnplmn);open(ALFD,"$fn.${alfsuff}-dat");$_=<ALFD>;@fnplmn=(split)[1,2];close ALFD;

  my@dfshg=split m.:.,$magcut[$filterstdcat{$filter}];
  my$zxpo=$zxpo[$filterstdcat{$filter}]+0;
  $zxpo=0;
  print "$cmd ($stdcut $magcut[$filterstdcat{$filter}] $zxpo) ";
  `${pathdir}stdVVVcleanNout $fn.stdcat $fn.$alfsuffcl $plmn[0] $plmn[1] $stdcut $dfshg[0] $dfshg[1] $filterstdcat{$filter} $notsamecol $zxpo $fn`;

   print "",`${pathdir}file_stat -lqn $fn.cal`," \x20";
   $qazstdat{$kkey}.="$fn.stdat ";

{
if(-e "${fn}.cal.rr"){my@rjr; open(REJR,"${fn}.cal.rr"); @rjr=<REJR>;close REJR; rename "${fn}.cal", "$fn.cal.tmp"; open(TCAL, "$fn.cal.tmp");open(CAL, ">$fn.cal");
while(<TCAL>){my @mm=(split)[3,5];my$flg=1;
for my$rjr(@rjr){ my@qqqq=split/\s+/,$rjr; $flg=0 if(@qqqq==4 && $qqqq[0]<=$mm[1] && $mm[1]<=$qqqq[1] && $qqqq[2]<=$mm[0] && $mm[0]<=$qqqq[3]); }
print CAL if($flg);}
close TCAL; close CAL; unlink "$fn.cal.tmp";}
print "",`${pathdir}file_stat -lqn $fn.cal`,"\n";
}

  my$flagfit=($notsamecol)? -2 :2;
  $flagfit=-2 if($filter=~/Y|Z/);

  if($calpar{$fn}){
    print "Using given calibrating parameters: $calpar{$fn}\n";
    @b=(split ' ',$calpar{$fn});
  }else{
    print "Finding calibrating parameters ";
    print "with SkZ-magnitude correction "if($skzmagcorr);
    print "... ";
    print "\n",@q=`${pathdir}vvvpbswlsqfit_erry  ${fn}.cal $flagfit $coeffpbsf[$fff{$filter}] `,"\n";
#    if($filter=~/Y|Z/){
#      @b=((split ' ',$q[4])[1..2], 0, 0);
#    }else{
      @b=((split ' ',$q[5])[1..2],(split ' ',$q[4])[1..2]);
#    }
  }

  {
    my$zpe=($b[1]>0.01)?$b[1]: 0.01;
    my$bbbb=$b[0]-3*$zpe;my $jfjf=$b[0]-3*$zpe+$b[2]*2;$bbbb=$jfjf if($bbbb>$jfjf);
    my$cccc=$b[0]+3*$zpe; $jfjf=$b[0]+3*$zpe+$b[2]*2;$cccc=$jfjf if($cccc<$jfjf);
    $bbbb=sprintf("%.2f",$bbbb);
    $cccc=sprintf("%.2f",$cccc);
    if($bbbb==$cccc){$bbbb-=0.03;$cccc+=0.03;}
    my($aaaa,$dddd)=($bbbb-.5,$cccc+.5);
    my$calpst=qq%set xlabel "J-%.(($flagfit>0)?"Ks":"H").qq%"\nset title "$fn"\nset ylabel "${filter}_{STD}-$filter"\n%;
    $calpst.=qq%plot [][$bbbb:$cccc] "${fn}.cal" u %.(($flagfit>0)?6:8).qq%:4:5 w err pt 2 noti, $b[0]+$b[2]*x, $b[0]-$b[1]+$b[2]*x ti "-1 sigma",$b[0]+$b[1]+$b[2]*x ti "+1 sigma"\n%;
    $calpst.=qq%plot [][$aaaa:$dddd] "${fn}.cal" u %.(($flagfit>0)?6:8).qq%:4:5 w err pt 2 noti, $b[0]+$b[2]*x, $b[0]-$b[1]+$b[2]*x ti "-1 sigma", $b[0]+$b[1]+$b[2]*x ti "+1 sigma"\n%;
    push @calps, $calpst;
  }

  if($calpar{$fn}){
    $cal{$fn}=$calpar{$fn};
  }else{
    $b[1]=0;
    $cal{$fn}=join " ",@b;
  }

  print CALF join "  ", $fn, @b,"\n";
}else {print "Not a valid filter for the calibration.\n"; }



 LIST:
  $regroup{sprintf("%s %3d  %8s \x20 %-3s %3d %5d",$tile, $fam, $obname, $filter, $chp, $offset)}.="${fn}.$alfsuffcl ";

 END:
  print "\n";
}
close DT;

{
