    &PlotDmCMD();
    &TooMASScmpplot();
 }elsif(@elit>1){
  for my$iii(0..$#fff){
    unlink "${workname}_${tok}_$fff[$iii].mag","${workname}_${tok}_$fff[$iii].raw";
    my$hgf="${workname}_$skffamo[0]_$fff[$iii].mag";
    if(-e $hgf){
      symlink $hgf, "${workname}_${tok}_$fff[$iii].mag";
    }
    @t_ty=@tfam_ty;
    unlink "${workname}_${tok}.stdat";
    symlink "${workname}_$skffamo[0].stdat", "${workname}_${tok}.stdat";
