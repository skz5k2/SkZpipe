      unlink "${workname}_${tok}_$fff[$iii].raw","${workname}_${tok}_$fff[$iii].cor" if(!$debug);
        print "\t==> ${workname}_${tok}_$fff[$iii].mag\n";
      }
      elsif(@files==1) {
        symlink $files[0], "${workname}_${tok}_$fff[$iii].mag";
